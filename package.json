{
  "name": "opensesameaiengineerportfolio",
  "private": true,
  "scripts": {
    "build": "node scripts/build-reach.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check:html": "html-validate public/index.html",
    "check:js": "node scripts/check-inline-js.mjs public/index.html",
    "check:deploy": "wrangler deploy --dry-run",
    "check": "npm run check:reach && npm run check:html && npm run check:js && npm run check:deploy",
    "check:reach": "node scripts/build-reach.mjs --check"
  },
  "devDependencies": {
    "html-validate": "^11.0.0",
    "wrangler": "^4.0.0"
  }
}
